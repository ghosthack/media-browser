<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ghosthack</groupId>
  <artifactId>media-browser</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>Media Browser</name>
  <description>Pure-Java desktop media browser: JavaFX UI with selectable decode backends.</description>

  <properties>
    <!-- CI-friendly version: release builds override with
         -Drevision=<tag-without-v>; normal development stays a snapshot. -->
    <revision>1.0.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>26</maven.compiler.release>
    <javafx.version>26</javafx.version>
    <lwjgl.version>3.4.1</lwjgl.version>
    <twelvemonkeys.version>3.13.1</twelvemonkeys.version>
    <!-- JavaCV (bundled FFmpeg), test scope only: mints video fixtures via
         FFmpegFrameRecorder (BackendEvaluationTest, JcodecMediaFacadeTest).
         The JAVACV / TWELVEMONKEYS_JAVACV runtime backends were retired
         2026-07-22. ffmpeg/javacpp versions are pinned to the JavaCV release. -->
    <javacv.version>1.5.13</javacv.version>
    <!-- FFmpeg preset version that ships with JavaCV 1.5.13. The preset
         coordinate is <ffmpeg-version>-<javacv-version>; verify it exists on
         Central before bumping (it does not always match the upstream FFmpeg
         release string). -->
    <ffmpeg.version>8.0.1-1.5.13</ffmpeg.version>
    <javacpp.version>1.5.13</javacpp.version>
    <!-- jcodec (pure Java: H.264/MPEG/ProRes) for the TWELVEMONKEYS_JCODEC
         backend's video path. No native; jcodec-javase adds AWTUtil. -->
    <jcodec.version>0.2.5</jcodec.version>
    <!-- Runtime logging facade used by the source-vendored robust-unrar core. -->
    <slf4j.version>2.0.17</slf4j.version>
    <!-- Default LWJGL + JavaCPP native classifiers; overridden per-OS by the
         profiles below (activated by os.family/os.arch). We deliberately use a
         single-platform JavaCPP classifier (mirroring the LWJGL natives) rather
         than org.bytedeco:ffmpeg-platform, which bundles every OS/arch native
         (hundreds of MB). -->
    <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
    <javacpp.platform>macosx-arm64</javacpp.platform>
    <!-- Bundled-FFmpeg backend (FFMPEG_FFM): FFM stubs + self-extracting
         from-source LGPL natives, built in ../ffmpeg-ffm, on Maven Central.
         Classifier jars exist for macos-arm64, windows-x64, and linux-x64. -->
    <ffmpegffm.version>8.1.2-0.3.1</ffmpegffm.version>
    <ffmpegffm.natives>macos-arm64</ffmpegffm.natives>
    <!-- libjpeg-turbo JPEG-thumbnail fast path (TurboJpegStills): FFM stubs +
         self-extracting natives, built in ../turbojpeg-ffm. Same platform
         coverage as ffmpeg-ffm; absent natives disable the fast path at
         runtime, they never break a build. -->
    <turbojpegffm.version>3.2.0-0.2.0</turbojpegffm.version>
    <turbojpegffm.natives>macos-arm64</turbojpegffm.natives>
    <!-- Camera-RAW route (LibRawStills): FFM stubs + self-extracting natives,
         built in ../libraw-ffm. Same platform coverage as ffmpeg-ffm; absent
         natives mean RAW extensions are not claimed, they never break a build. -->
    <librawffm.version>0.22.2-0.2.0</librawffm.version>
    <librawffm.natives>macos-arm64</librawffm.natives>
    <junit.version>5.11.4</junit.version>
    <app.mainClass>io.github.ghosthack.mediabrowser.App</app.mainClass>
    <app.launcherClass>io.github.ghosthack.mediabrowser.Launcher</app.launcherClass>
    <!-- Mosaic thumbnail/UI telemetry knobs, forwarded to the forked javafx:run
         JVM via the plugin <options> below. Override on the command line, e.g.
         mvn javafx:run -Dmosaic.telemetry=true. Defaults keep it off. -->
    <mosaic.telemetry>false</mosaic.telemetry>
    <mosaic.telemetry.intervalMs>5000</mosaic.telemetry.intervalMs>
    <mosaic.telemetry.fxStallMs>50</mosaic.telemetry.fxStallMs>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>${lwjgl.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>${lwjgl.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>${lwjgl.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <!-- TwelveMonkeys ImageIO SPI plugins (pure Java, no native). They register
         with javax.imageio so the JDK ImageIO sees them on the classpath. Used
         by the TWELVEMONKEYS* backends for stills + animated GIF. imageio-batik
         (SVG) and imageio-pdf are deliberately excluded as heavy. -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-tiff</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-bmp</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-psd</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pnm</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-tga</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-icns</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pcx</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-sgi</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-iff</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pict</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-hdr</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-thumbsdb</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <!-- JavaCV, TEST ONLY: FFmpegFrameRecorder mints the video fixtures the
         backend-evaluation and jcodec tests decode. No runtime backend uses
         it (JavaCV pair retired 2026-07-22), so nothing bytedeco ships in the
         distribution. We pull only the ffmpeg preset (not javacv-platform /
         opencv / etc.); the natives are single-platform via the
         ${javacpp.platform} classifier (see the per-OS profiles). -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacv</artifactId>
      <version>${javacv.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- Strip every non-FFmpeg bytedeco preset javacv drags in (opencv,
             openblas, leptonica, tesseract, etc.); we only use FFmpeg. -->
        <exclusion><groupId>org.bytedeco</groupId><artifactId>opencv</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>flycapture</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>libdc1394</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>libfreenect</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>libfreenect2</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>librealsense</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>librealsense2</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>videoinput</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>artoolkitplus</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>flandmark</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>leptonica</artifactId></exclusion>
        <exclusion><groupId>org.bytedeco</groupId><artifactId>tesseract</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- FFmpeg preset Java API (transitively pulled by javacv, pinned here for
         clarity) + single-platform native. Test scope, like javacv above. -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <classifier>${javacpp.platform}</classifier>
      <scope>test</scope>
    </dependency>
    <!-- JavaCPP runtime loader native (single-platform). -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
      <classifier>${javacpp.platform}</classifier>
      <scope>test</scope>
    </dependency>
    <!-- Bundled-FFmpeg backend: see the ffmpegffm.* properties above. -->
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>ffmpeg-ffm</artifactId>
      <version>${ffmpegffm.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>ffmpeg-ffm-natives</artifactId>
      <version>${ffmpegffm.version}</version>
      <classifier>${ffmpegffm.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <!-- TurboJPEG fast path: see the turbojpegffm.* properties above. -->
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>turbojpeg-ffm</artifactId>
      <version>${turbojpegffm.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>turbojpeg-ffm-natives</artifactId>
      <version>${turbojpegffm.version}</version>
      <classifier>${turbojpegffm.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <!-- Camera-RAW route: see the librawffm.* properties above. -->
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>libraw-ffm</artifactId>
      <version>${librawffm.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ghosthack</groupId>
      <artifactId>libraw-ffm-natives</artifactId>
      <version>${librawffm.version}</version>
      <classifier>${librawffm.natives}</classifier>
      <scope>runtime</scope>
    </dependency>
    <!-- jcodec: pure-Java pull-decode (FrameGrab) for H.264/MPEG/ProRes in
         MP4/MOV/MKV, used video-only behind TwelveMonkeys in the
         TWELVEMONKEYS_JCODEC backend. jcodec-javase provides AWTUtil
         (Picture → BufferedImage). No native libraries. -->
    <dependency>
      <groupId>org.jcodec</groupId>
      <artifactId>jcodec</artifactId>
      <version>${jcodec.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jcodec</groupId>
      <artifactId>jcodec-javase</artifactId>
      <version>${jcodec.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Pick the LWJGL native classifier for the host OS/arch. Each profile is
       auto-activated by Maven's OS detection; -Dlwjgl.natives=... still wins. -->
  <profiles>
    <profile>
      <id>lwjgl-natives-windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties>
        <lwjgl.natives>natives-windows</lwjgl.natives>
        <javacpp.platform>windows-x86_64</javacpp.platform>
        <ffmpegffm.natives>windows-x64</ffmpegffm.natives>
        <turbojpegffm.natives>windows-x64</turbojpegffm.natives>
        <librawffm.natives>windows-x64</librawffm.natives>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-macos-arm64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
        <javacpp.platform>macosx-arm64</javacpp.platform>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-macos-x64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-macos</lwjgl.natives>
        <javacpp.platform>macosx-x86_64</javacpp.platform>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-linux</id>
      <activation><os><family>unix</family><name>linux</name></os></activation>
      <properties>
        <lwjgl.natives>natives-linux</lwjgl.natives>
        <javacpp.platform>linux-x86_64</javacpp.platform>
        <ffmpegffm.natives>linux-x64</ffmpegffm.natives>
        <turbojpegffm.natives>linux-x64</turbojpegffm.natives>
        <librawffm.natives>linux-x64</librawffm.natives>
      </properties>
    </profile>
    <!-- Stage the application and runtime-scope dependencies exactly as
         jpackage expects them. The native profile above ensures this directory
         contains one OS/architecture's native classifier jars, never all of
         them. scripts/package.sh activates this profile after cleaning target. -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <configuration>
              <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>stage-jpackage-runtime-dependencies</id>
                <phase>package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                  <overWriteIfNewer>true</overWriteIfNewer>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <!-- The OSS source export and the application JAR share one explicit
           redistribution manifest. This keeps upstream development notes and
           roadmaps out while retaining the required license/notice records
           and the provenance manifests for source-vendored archive readers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>stage-archive-redistribution-metadata</id>
            <phase>process-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <delete
                    dir="${project.build.outputDirectory}/META-INF/licenses/archive"
                    quiet="true"/>
                <mkdir
                    dir="${project.build.outputDirectory}/META-INF/licenses/archive"/>
                <copy
                    todir="${project.build.outputDirectory}/META-INF/licenses/archive"
                    failonerror="true">
                  <fileset
                      dir="${project.basedir}/vendor/archive"
                      includesfile="${project.basedir}/vendor/archive/REDISTRIBUTION.allowlist"/>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${app.launcherClass}</mainClass>
            </manifest>
            <manifestEntries>
              <Implementation-Title>${project.name}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Implementation-Vendor>ghosthack contributors</Implementation-Vendor>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <!-- Vendored pure-Java decoders (io.github.ghosthack.media.pure.*)
               use the incubating Vector API in av1/hevc/jpeg/spng. -->
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Same runtime module the app needs: the pure decoders' DSP
               kernels (AvcDsp & co.) use the incubating Vector API. -->
          <argLine>--add-modules jdk.incubator.vector</argLine>
        </configuration>
        <!--
          The bytedeco fixture-minting tests must not share a JVM with anything
          that loads the bundled ffmpeg-ffm natives.

          On Windows the dynamic loader matches already-loaded modules by BASE
          NAME, and org.bytedeco:ffmpeg 8.0.1 ships avutil-60.dll / avcodec-62.dll
          / avformat-62.dll — exactly the names our FFmpeg 8.1.2 bundle uses. Once
          bytedeco's copies are in the process, ffmpeg-ffm's avcodec-62.dll
          resolves its imports against bytedeco's avutil-60 and fails to load, so
          every later ffmpeg-ffm test dies with "Cannot open library". It is
          permanent for the life of that JVM, not a transient/AV hiccup.

          macOS and Linux are unaffected: those builds resolve dependencies by
          @loader_path / RPATH, i.e. by path rather than base name.

          Splitting into two executions gives each set a fresh fork — two JVMs
          total, far cheaper than reuseForks=false per class.
        -->
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/BackendEvaluationTest.java</exclude>
                <exclude>**/JcodecMediaFacadeTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>bytedeco-fixture-tests</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <includes>
                <include>**/BackendEvaluationTest.java</include>
                <include>**/JcodecMediaFacadeTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${app.mainClass}</mainClass>
          <options>
            <!-- JavaFX 26 EXTENDED/HeaderBar window chrome is a preview API. -->
            <option>-Djavafx.enablePreview=true</option>
            <option>-Djavafx.suppressPreviewWarning=true</option>
            <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
            <!-- Vendored pure-Java decoders use the incubating Vector API -->
            <option>--add-modules=jdk.incubator.vector</option>
            <!-- LWJGL's memory utilities still use sun.misc.Unsafe -->
            <option>--sun-misc-unsafe-memory-access=allow</option>
            <!-- Glass window handles for MacWindowResizable (chromeless mode) -->
            <option>--add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED</option>
            <!-- Stage -> Glass peer for MacWindowFrame (native overscan maximize) -->
            <option>--add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED</option>
            <option>--add-exports=javafx.graphics/com.sun.javafx.tk.quantum=ALL-UNNAMED</option>
            <!-- Mosaic telemetry: interpolated from the properties above; the
                 forked JVM does not inherit Maven's -D properties otherwise. -->
            <option>-Dmosaic.telemetry=${mosaic.telemetry}</option>
            <option>-Dmosaic.telemetry.intervalMs=${mosaic.telemetry.intervalMs}</option>
            <option>-Dmosaic.telemetry.fxStallMs=${mosaic.telemetry.fxStallMs}</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
